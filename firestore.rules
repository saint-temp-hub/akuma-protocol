rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() <= 64;
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['roomCode', 'phase', 'stateJson', 'updatedAt'])
        && data.keys().hasOnly(['roomCode', 'phase', 'stateJson', 'updatedAt'])
        && data.roomCode is string && data.roomCode.size() <= 10
        && data.phase is string && data.phase.size() <= 32
        && data.stateJson is string && data.stateJson.size() <= 100000
        && data.updatedAt is number;
    }

    match /rooms/{roomId} {
      allow read: if isValidId(roomId);
      allow create: if isValidId(roomId) && isValidRoom(request.resource.data);
      allow update: if isValidId(roomId) && isValidRoom(request.resource.data);
      allow delete: if false;
    }
  }
}
